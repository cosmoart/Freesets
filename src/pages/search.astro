---
import Layout from '@/layouts/Layout.astro'
import AssetCard from '@/components/AssetCard.astro'
import Pagination from '@/components/Pagination.astro'
import categories from '@/assets/categories'
import { DEFAULT_PER_PAGE } from '@/scripts/view'
import ViewControls from '@/components/ViewControls.astro'
import EmptyState from '@/components/EmptyState.astro'

const results = categories.flatMap((category) =>
	category.assets.map((asset) => ({
		asset,
		category,
		license: (asset.license ?? asset.licence)?.trim() ?? ''
	}))
)

const licenses = [...new Set(results.map(({ license }) => license).filter(Boolean))].sort((a, b) =>
	a.localeCompare(b)
)
---

<Layout
	title="Search - Freesets"
	description="Search across every free resource and tool collected in Freesets."
	image="https://res.cloudinary.com/cosmocloudinary/image/upload/f_auto,q_auto/v1/freesets/og/home"
>
	<section class="grow">
		<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
			<h1 class="text-4xl font-semibold">Search</h1>

			<ViewControls />

			<Pagination />
		</div>

		<form
			data-filters
			class="mb-8 flex flex-wrap items-center gap-3 rounded-lg border-2 border-zinc-200 p-4 dark:border-zinc-800"
		>
			<input
				type="search"
				name="q"
				autocomplete="off"
				placeholder="Name, tag or license..."
				class="min-w-56 grow rounded-md border-2 border-zinc-200 px-3 py-2 outline-none focus:border-zinc-400 dark:border-zinc-700 dark:focus:border-zinc-500"
			/>

			<select
				name="category"
				aria-label="Category"
				class="rounded-md border-2 border-zinc-200 px-3 py-2 dark:border-zinc-700 dark:bg-zinc-900"
			>
				<option value="">All categories</option>
				{categories.map((category) => <option value={category.nameID}>{category.name}</option>)}
			</select>

			<select
				name="license"
				aria-label="License"
				class="rounded-md border-2 border-zinc-200 px-3 py-2 dark:border-zinc-700 dark:bg-zinc-900"
			>
				<option value="">All licenses</option>
				{licenses.map((license) => <option value={license}>{license}</option>)}
			</select>

			<button
				type="reset"
				class="rounded-md bg-zinc-900 px-4 py-2 text-white dark:bg-white dark:text-zinc-950"
			>
				Clear
			</button>
		</form>

		<p data-count class="mb-6 text-zinc-500"></p>

		<ul data-results class="flex flex-wrap">
			{
				results.map(({ asset, category, license }, index) => (
					<li
						data-item
						hidden={index >= DEFAULT_PER_PAGE}
						data-category={category.nameID}
						data-license={license}
						data-label={asset.name}
						data-link={asset.link}
						data-meta={[license, ...(asset.tags ?? [])]
							.filter(Boolean)
							.join(String.fromCharCode(32, 183, 32))}
						data-text={[asset.name, license, ...(asset.tags ?? [])].join(' ').toLowerCase()}
					>
						<AssetCard asset={asset} color={category.color} />
					</li>
				))
			}
		</ul>

		<EmptyState />
	</section>
</Layout>

<script>
	import { paginate } from '@/scripts/paginate'
	import { readPerPage } from '@/scripts/view'
	import { matches as textMatches } from '@/scripts/filter'
	import { closestTo, renderEmpty, type EmptyFilter } from '@/scripts/empty'

	let perPage = 0
	let onPerPageChange: (() => void) | undefined

	document.addEventListener('view:perpage', (event) => {
		perPage = (event as CustomEvent<number>).detail
		onPerPageChange?.()
	})

	function setup() {
		const form = document.querySelector<HTMLFormElement>('[data-filters]')
		const nav = document.querySelector<HTMLElement>('[data-pagination]')
		if (!form || !nav) return

		const query = form.elements.namedItem('q') as HTMLInputElement
		const category = form.elements.namedItem('category') as HTMLSelectElement
		const license = form.elements.namedItem('license') as HTMLSelectElement
		const count = document.querySelector<HTMLParagraphElement>('[data-count]')!
		const empty = document.querySelector<HTMLElement>('[data-empty]')!
		const items = [...document.querySelectorAll<HTMLLIElement>('[data-item]')]

		const params = new URLSearchParams(location.search)
		query.value = params.get('q') ?? ''
		category.value = params.get('category') ?? ''
		license.value = params.get('license') ?? ''
		let page = Number(params.get('page')) || 1
		perPage = readPerPage()

		/** Every item passing the active filters, optionally ignoring one of them. */
		function select(search: string, skip?: 'category' | 'license') {
			return items.filter(
				(item) =>
					textMatches(item.dataset.text ?? '', search) &&
					(skip === 'category' || !category.value || item.dataset.category === category.value) &&
					(skip === 'license' || !license.value || item.dataset.license === license.value)
			)
		}

		function describe(select: HTMLSelectElement) {
			return select.options[select.selectedIndex]?.text ?? select.value
		}

		function apply(scroll = false) {
			const search = query.value.trim()
			const matches = select(search)
			const found = new Set(matches)

			for (const item of items) item.hidden = !found.has(item)

			page = paginate(nav!, matches, page, perPage)
			count.textContent = `${matches.length} ${matches.length === 1 ? 'resource' : 'resources'} found`
			empty.hidden = matches.length > 0

			if (matches.length === 0) {
				const filters: EmptyFilter[] = []

				if (license.value) {
					filters.push({
						label: describe(license),
						count: select(search, 'license').length,
						clear: () => {
							license.value = ''
							reset()
						}
					})
				}

				if (category.value) {
					filters.push({
						label: describe(category),
						count: select(search, 'category').length,
						clear: () => {
							category.value = ''
							reset()
						}
					})
				}

				renderEmpty(empty, {
					query: search,
					scope: category.value ? describe(category) : 'all resources',
					filters,
					closest: closestTo(items, search),
					onTerm: (term) => {
						query.value = term
						reset()
					}
				})
			}

			const next = new URLSearchParams()
			if (query.value) next.set('q', query.value)
			if (category.value) next.set('category', category.value)
			if (license.value) next.set('license', license.value)
			if (page > 1) next.set('page', String(page))

			history.replaceState(history.state, '', next.size ? `?${next}` : location.pathname)
			if (scroll) window.scrollTo({ top: 0, behavior: 'smooth' })
		}

		function reset() {
			page = 1
			apply()
		}

		form.addEventListener('submit', (event) => event.preventDefault())
		form.addEventListener('input', reset)
		form.addEventListener('change', reset)
		form.addEventListener('reset', () => requestAnimationFrame(reset))

		nav.addEventListener('click', (event) => {
			const button = (event.target as HTMLElement).closest<HTMLElement>('[data-page]')
			if (!button) return
			page = Number(button.dataset.page)
			apply(true)
		})

		onPerPageChange = () => {
			page = 1
			apply()
		}

		apply()
	}

	document.addEventListener('astro:page-load', setup)
</script>
