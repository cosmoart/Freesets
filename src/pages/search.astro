---
import Layout from '@/layouts/Layout.astro'
import AssetCard from '@/components/AssetCard.astro'
import ResultsBar from '@/components/ResultsBar.astro'
import categories from '@/assets/categories'
import ViewControls from '@/components/ViewControls.astro'
import EmptyState from '@/components/EmptyState.astro'
import type { Asset } from '@/types'

const licenses = [
	...new Set(
		categories
			.flatMap((category) => category.assets)
			.map((asset) => asset.license?.trim() ?? '')
			.filter(Boolean)
	)
].sort((a, b) => a.localeCompare(b))

// Results are drawn in the browser from /search-index.json, one page at a time. The page only
// ships AssetCard as a template, with and without a license link, for scripts/card.ts to fill.
const sample: Asset = {
	id: 0,
	name: '',
	link: 'https://freesets.dev',
	img: '',
	order: 0,
	tags: [''],
	license: ' '
}
---

<Layout
	title="Search - Freesets"
	description="Search across every free resource and tool collected in Freesets."
	image="https://res.cloudinary.com/cosmocloudinary/image/upload/f_auto,q_auto/v1/freesets/og/home"
>
	<section class="grow">
		<div
			class="-mx-4 mb-6 border-y border-line bg-[radial-gradient(90%_140%_at_50%_0%,rgb(43_109_255/0.1),transparent_70%)] px-4 py-8 sm:py-10"
		>
			<form data-filters class="mx-auto flex max-w-3xl flex-col gap-3.5">
				<label
					class="flex h-14 items-center gap-3 rounded-[14px] surface px-4.5 focus-within:border-line-strong"
				>
					<svg
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
						class="size-5 shrink-0 text-muted"
					>
						<path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path>
						<path d="M21 21l-6 -6"></path>
					</svg>
					<span class="sr-only">Search resources</span>
					<input
						type="search"
						name="q"
						autocomplete="off"
						placeholder="Name, tag or license..."
						class="w-full min-w-0 bg-transparent text-lg tracking-tight outline-none placeholder:text-subtle"
					/>
				</label>

				<div class="flex flex-wrap items-center gap-2.5">
					<select
						name="category"
						aria-label="Category"
						class="cursor-pointer dropdown control py-2 pr-8 pl-3 text-sm outline-none"
					>
						<option value="">All categories</option>
						{categories.map((category) => <option value={category.nameID}>{category.name}</option>)}
					</select>

					<select
						name="license"
						aria-label="License"
						class="cursor-pointer dropdown control py-2 pr-8 pl-3 text-sm outline-none"
					>
						<option value="">All licenses</option>
						{licenses.map((license) => <option value={license}>{license}</option>)}
					</select>

					<button type="reset" class="btn btn-ghost">Clear</button>
				</div>
			</form>
		</div>

		<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
			<div class="flex flex-wrap items-baseline gap-3">
				<h1 class="text-2xl font-semibold">Search</h1>
				<p data-count class="text-sm text-muted"></p>
			</div>

			<ViewControls />
		</div>

		<ul data-results aria-busy="true"></ul>

		<div class="mt-6">
			<ResultsBar />
		</div>

		<template data-card-template="link">
			<li>
				<AssetCard
					asset={{ ...sample, licenseLink: 'https://freesets.dev' }}
					color=""
					label=" "
					isNew
				/>
			</li>
		</template>

		<template data-card-template="plain">
			<li><AssetCard asset={sample} color="" label=" " isNew /></li>
		</template>

		<EmptyState />
	</section>
</Layout>

<script>
	import { renderPages } from '@/scripts/paginate'
	import { DEFAULT_COLUMNS, readPerPage } from '@/scripts/view'
	import { matches as textMatches } from '@/scripts/filter'
	import { closestTo, renderEmpty, type EmptyFilter } from '@/scripts/empty'
	import { loadSearchIndex } from '@/scripts/search-index'
	import { renderCard } from '@/scripts/card'

	let perPage = 0
	let onPerPageChange: (() => void) | undefined

	document.addEventListener('view:perpage', (event) => {
		perPage = (event as CustomEvent<number>).detail
		onPerPageChange?.()
	})

	async function setup() {
		const form = document.querySelector<HTMLFormElement>('[data-filters]')
		const nav = document.querySelector<HTMLElement>('[data-pagination]')
		const list = document.querySelector<HTMLUListElement>('[data-results]')
		if (!form || !nav || !list) return

		const query = form.elements.namedItem('q') as HTMLInputElement
		const category = form.elements.namedItem('category') as HTMLSelectElement
		const license = form.elements.namedItem('license') as HTMLSelectElement
		const count = document.querySelector<HTMLParagraphElement>('[data-count]')!
		const empty = document.querySelector<HTMLElement>('[data-empty]')!
		const templates = {
			link: document.querySelector<HTMLTemplateElement>('[data-card-template="link"]')!,
			plain: document.querySelector<HTMLTemplateElement>('[data-card-template="plain"]')!
		}

		const params = new URLSearchParams(location.search)
		query.value = params.get('q') ?? ''
		category.value = params.get('category') ?? ''
		license.value = params.get('license') ?? ''
		let page = Number(params.get('page')) || 1
		perPage = readPerPage()

		form.addEventListener('submit', (event) => event.preventDefault())

		count.textContent = 'Loading resources…'
		const index = await loadSearchIndex()

		// The visitor may have left the page while the index was loading
		if (!list.isConnected) return

		if (index.length === 0) {
			count.textContent = 'Resources could not be loaded. Reload the page to try again.'
			return
		}

		const entries = index.map((entry) => ({
			...entry,
			label: entry.name,
			meta: [entry.license, ...entry.tags].filter(Boolean).join(' · '),
			text: [entry.name, entry.license, ...entry.tags].join(' ').toLowerCase()
		}))

		/** Every entry passing the active filters, optionally ignoring one of them. */
		function select(search: string, skip?: 'category' | 'license') {
			return entries.filter(
				(entry) =>
					textMatches(entry.text, search) &&
					(skip === 'category' || !category.value || entry.nameID === category.value) &&
					(skip === 'license' || !license.value || entry.license === license.value)
			)
		}

		function describe(select: HTMLSelectElement) {
			return select.options[select.selectedIndex]?.text ?? select.value
		}

		function apply(scroll = false) {
			const search = query.value.trim()
			const found = select(search)

			page = renderPages(nav!, found.length, page, perPage)
			const start = (page - 1) * perPage

			list!.replaceChildren(
				...found
					.slice(start, start + perPage)
					.map((entry, position) => renderCard(templates, entry, position < DEFAULT_COLUMNS))
			)

			count.textContent = `${found.length} ${found.length === 1 ? 'resource' : 'resources'} found`
			empty.hidden = found.length > 0

			if (found.length === 0) {
				const filters: EmptyFilter[] = []

				if (license.value) {
					filters.push({
						label: describe(license),
						count: select(search, 'license').length,
						clear: () => {
							license.value = ''
							reset()
						}
					})
				}

				if (category.value) {
					filters.push({
						label: describe(category),
						count: select(search, 'category').length,
						clear: () => {
							category.value = ''
							reset()
						}
					})
				}

				renderEmpty(empty, {
					query: search,
					scope: category.value ? describe(category) : 'all resources',
					filters,
					closest: closestTo(entries, search),
					onTerm: (term) => {
						query.value = term
						reset()
					}
				})
			}

			const next = new URLSearchParams()
			if (query.value) next.set('q', query.value)
			if (category.value) next.set('category', category.value)
			if (license.value) next.set('license', license.value)
			if (page > 1) next.set('page', String(page))

			history.replaceState(history.state, '', next.size ? `?${next}` : location.pathname)
			// Instant, not smooth: the results slide in on their own, and a smooth scroll on top of
			// that reads as the whole page gliding.
			if (scroll) window.scrollTo({ top: 0, behavior: 'instant' })
		}

		function reset() {
			page = 1
			apply()
		}

		form.addEventListener('input', reset)
		form.addEventListener('change', reset)
		form.addEventListener('reset', () => requestAnimationFrame(reset))

		nav.addEventListener('click', (event) => {
			const button = (event.target as HTMLElement).closest<HTMLElement>('[data-page]')
			if (!button) return
			page = Number(button.dataset.page)
			apply(true)
		})

		onPerPageChange = () => {
			page = 1
			apply()
		}

		apply()
		list.removeAttribute('aria-busy')
	}

	document.addEventListener('astro:page-load', setup)
</script>
