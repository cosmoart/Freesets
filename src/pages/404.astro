---
import Layout from '@/layouts/Layout.astro'
import categories from '@/assets/categories'
import GlowBlobs from '@/components/GlowBlobs.astro'

const total = categories.reduce((acc, category) => acc + category.assets.length, 0)
---

<Layout
	title="Page not found - Freesets"
	description="The page you are looking for does not exist."
	noindex
	image="https://cdn.freesets.dev/og/home.jpg"
>
	<GlowBlobs slot="backdrop" />

	<section
		class="relative flex grow flex-col items-center justify-center gap-5 py-20 pt-10 text-center"
	>
		<p
			class="text-md relative rounded-full border border-line bg-field px-3 py-1 eyebrow font-medium tracking-[0.22em]"
		>
			Error 404
		</p>

		<h1
			class="relative -my-[0.14em] bg-linear-to-b from-ink from-30% to-muted bg-clip-text p-[0.14em] text-7xl leading-[1] font-bold tracking-tighter text-transparent sm:text-[8.25rem]"
		>
			Nothing here
		</h1>

		<p class="relative max-w-lg text-lg text-balance text-soft">
			This page moved, or it never existed. The other {total} resources are still where you left them.
		</p>

		<div class="relative mt-3 flex flex-wrap items-center justify-center gap-2.5">
			<a href="/" class="group btn h-10.5 btn-primary px-8 text-sm">
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
					class="size-4 transition-transform duration-200 group-hover:-translate-x-1 group-focus-visible:-translate-x-1 motion-reduce:transition-none"
				>
					<path d="M19 12H5M11 6l-6 6 6 6"></path>
				</svg>
				Back to home
			</a>
		</div>
	</section>
</Layout>
