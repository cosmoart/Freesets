---
import Layout from '@/layouts/Layout.astro'
import categories from '@/assets/categories'
import RecentlyAdded from '@/components/RecentlyAdded.astro'
import CategoryGrid from '@/components/CategoryGrid.astro'
import GlowBlobs from '@/components/GlowBlobs.astro'
// import HeroRays from '@/components/HeroRays.astro'

const description =
	'Hand-picked free resources for developers and designers: icons, illustrations, photos, fonts, colors, UI components and tools, all in one searchable library.'
const total = categories.reduce((acc, category) => acc + category.assets.length, 0)
// Shorter line for the hero; the full description above stays in the meta tags.
const tagline =
	'Hand-picked free icons, illustrations, photos, fonts, UI components and tools for developers and designers.'
const site = Astro.site!.href

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${site}#website`,
			url: site,
			name: 'Freesets',
			description,
			inLanguage: 'en',
			potentialAction: {
				'@type': 'SearchAction',
				target: { '@type': 'EntryPoint', urlTemplate: `${site}search?q={search_term_string}` },
				'query-input': 'required name=search_term_string'
			}
		},
		{
			'@type': 'ItemList',
			name: 'Freesets categories',
			itemListElement: categories.map((category, index) => ({
				'@type': 'ListItem',
				position: index + 1,
				name: category.headline,
				url: new URL(`/${category.nameID}`, site).href
			}))
		}
	]
}
---

<Layout
	title="Freesets - Free resources for developers and designers"
	description={description}
	jsonLd={jsonLd}
	image="https://cdn.freesets.dev/og/home.jpg"
>
	<!-- <HeroRays slot="backdrop" /> -->
	<GlowBlobs slot="backdrop" />

	<div class="flex grow flex-col pb-16">
		<section
			class="relative -mx-4 flex h-96 flex-col items-center justify-center overflow-hidden px-4 text-center sm:h-104"
		>
			<div class="relative -mt-8 flex flex-col items-center gap-4">
				<h1
					class="hero-title -my-[0.14em] p-[0.14em] text-7xl leading-[1] font-bold tracking-[-0.045em] sm:text-[7.5rem]"
				>
					Freesets
				</h1>
				<p class="max-w-2xl text-lg text-balance text-soft">{tagline}</p>
				<p
					class="mt-1 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 eyebrow text-xs tracking-[0.08em]"
				>
					<span>{total} resources</span>
					<span aria-hidden="true" class="text-line-strong">/</span>
					<span>{categories.length} categories</span>
				</p>
			</div>
		</section>

		<div
			class="slab relative z-10 -mt-7 flex flex-col gap-12 rounded-[20px] border border-line bg-raised p-4 sm:p-6"
		>
			<RecentlyAdded />

			<CategoryGrid />
		</div>
	</div>
</Layout>

<style>
	.hero-title {
		background: linear-gradient(to bottom, var(--ink) 30%, var(--muted));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.slab {
		box-shadow:
			0 -18px 50px var(--slab-shadow),
			inset 0 1px 0 var(--highlight);
	}
</style>
