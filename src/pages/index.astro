---
import Layout from '@/layouts/Layout.astro'
import categories from '@/assets/categories'
import RecentlyAdded from '@/components/RecentlyAdded.astro'
import CategoryGrid from '@/components/CategoryGrid.astro'

const description =
	'Freesets is a vast collection of the best free resources and tools for developers and artists, such as icons, illustrations, photos, videos, blogs, fonts, colors, etc.'
const total = categories.reduce((acc, category) => acc + category.assets.length, 0)

// Uneven on purpose so the spectrum reads as a skyline, one bar per category in order.
const heights = [72, 47, 87, 36, 63, 100, 44, 69, 53, 83, 59, 39, 75, 51]
// step is the distance from the middle of the row, so the rise animation ripples outwards.
const middle = (categories.length - 1) / 2
const bars = categories.map((category, index) => ({
	color: category.color,
	height: heights[index % heights.length],
	step: Math.abs(index - middle)
}))
---

<Layout
	title="Freesets"
	description={description}
	image="https://res.cloudinary.com/cosmocloudinary/image/upload/f_auto,q_auto/v1/freesets/og/home"
>
	<div class="flex grow flex-col pb-16">
		<section
			class="relative -mx-4 flex h-96 flex-col items-center justify-center overflow-hidden px-4 text-center sm:h-104"
		>
			<div aria-hidden="true" class="spectrum">
				<div class="spectrum-glow">
					{
						bars.map((bar) => (
							<span style={`--bar: ${bar.color}; --h: ${bar.height}%; --step: ${bar.step}`} />
						))
					}
				</div>
				<div class="spectrum-bars">
					{
						bars.map((bar) => (
							<span style={`--bar: ${bar.color}; --h: ${bar.height}%; --step: ${bar.step}`} />
						))
					}
				</div>
			</div>

			<div class="relative -mt-8 flex flex-col items-center gap-4">
				<h1
					class="hero-title -my-[0.14em] p-[0.14em] text-7xl leading-[1] font-bold tracking-[-0.045em] sm:text-[7.5rem]"
				>
					Freesets
				</h1>
				<p class="max-w-xl text-lg text-balance text-soft">{description}</p>
				<p
					class="mt-1 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 eyebrow text-xs tracking-[0.08em]"
				>
					<span>{total} resources</span>
					<span aria-hidden="true" class="text-line-strong">/</span>
					<span>{categories.length} categories</span>
				</p>
			</div>
		</section>

		<div
			class="slab relative z-10 -mt-7 flex flex-col gap-12 rounded-[20px] border border-line bg-raised p-4 sm:p-6"
		>
			<RecentlyAdded />

			<CategoryGrid />
		</div>
	</div>
</Layout>

<style>
	.spectrum {
		--glow-opacity: 0.28;
		--bar-opacity: 0.5;
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	:global(.dark) .spectrum {
		--glow-opacity: 0.5;
		--bar-opacity: 1;
	}

	.spectrum > div {
		position: absolute;
		display: flex;
		align-items: flex-end;
	}

	.spectrum span {
		flex: 1;
		height: var(--h);
		transform-origin: bottom;
		/* The middle pair rises first and the rest follow outwards, like an equaliser opening up. */
		animation: bar-rise 650ms cubic-bezier(0.2, 0, 0, 1) both;
		animation-delay: calc(var(--step) * 55ms);
	}

	@keyframes bar-rise {
		from {
			scale: 1 0;
			opacity: 0;
		}
	}

	.spectrum-glow {
		inset-inline: -10%;
		bottom: -3.75rem;
		height: 26rem;
		gap: 1.625rem;
		opacity: var(--glow-opacity);
		filter: blur(46px);
	}

	.spectrum-glow span {
		border-radius: 5rem;
		background: var(--bar);
	}

	.spectrum-bars {
		inset-inline: 2.5rem;
		bottom: 0;
		height: 18.75rem;
		gap: 0.875rem;
		opacity: var(--bar-opacity);
	}

	.spectrum-bars span {
		border-radius: 0.75rem 0.75rem 0 0;
		background: linear-gradient(
			to bottom,
			var(--bar),
			color-mix(in srgb, var(--bar) 6%, transparent)
		);
		box-shadow: 0 0 46px color-mix(in srgb, var(--bar) 45%, transparent);
	}

	/* Washes the bars back into the page so the title sits on calm ground. */
	.spectrum::after {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(
			120% 80% at 50% 12%,
			color-mix(in srgb, var(--canvas) 94%, transparent) 30%,
			color-mix(in srgb, var(--canvas) 50%, transparent) 62%,
			color-mix(in srgb, var(--canvas) 86%, transparent) 100%
		);
	}

	.hero-title {
		background: linear-gradient(to bottom, var(--ink) 30%, var(--muted));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.slab {
		box-shadow:
			0 -18px 50px var(--slab-shadow),
			inset 0 1px 0 var(--highlight);
	}

	@media (width < 40rem) {
		.spectrum-bars {
			inset-inline: 0.5rem;
			gap: 0.375rem;
		}

		.spectrum-glow {
			gap: 0.75rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.spectrum span {
			animation: none;
		}
	}

	@media (prefers-reduced-transparency: reduce) {
		.spectrum-glow {
			display: none;
		}
	}
</style>
