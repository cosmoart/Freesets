---
import StarSparkles from '@/components/StarSparkles.astro'
import { REPO, getStars, formatStars } from '@/lib/github'

const stars = await getStars()
---

<a
	data-stars
	data-repo={REPO}
	href={`https://github.com/${REPO}`}
	target="_blank"
	rel="noopener noreferrer"
	aria-label={`Star ${REPO} on GitHub`}
	title={`Star ${REPO} on GitHub`}
	class="star-btn btn gap-0 overflow-hidden btn-ghost px-0"
>
	<span class="star-icon star-flip mx-2.5 size-4">
	<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class="star-front size-4">
		<path
			d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
		></path>
	</svg>
	<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class="star-glyph star-back size-4">
		<path
			d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"
		></path>
	</svg>
	<StarSparkles />
	</span>

	<span class="-ml-1 hidden pe-2.5 sm:inline">Star</span>

	<span
		data-stars-count
		hidden={stars === null}
		class="star-count flex h-full items-center border-l border-line px-2.5 font-mono text-[13px] text-ink tabular-nums"
	>
		{stars === null ? '' : formatStars(stars)}
	</span>
</a>

<script>
	import { formatStars } from '@/lib/github'

	const CACHE_KEY = 'freesets:stars'

	async function setup() {
		const link = document.querySelector<HTMLAnchorElement>('[data-stars]')
		// The header and footer counters are both baked in at build time, so refresh every one of them
		const outputs = document.querySelectorAll<HTMLElement>('[data-stars-count]')
		if (!link || !outputs.length) return

		const show = (stars: number) => {
			for (const output of outputs) {
				output.textContent = formatStars(stars)
				output.hidden = false
			}
		}

		try {
			const cached = sessionStorage.getItem(CACHE_KEY)
			if (cached) return show(Number(cached))

			const response = await fetch(`https://api.github.com/repos/${link.dataset.repo}`)
			if (!response.ok) return

			const { stargazers_count: stars } = await response.json()
			sessionStorage.setItem(CACHE_KEY, String(stars))
			show(stars)
		} catch {
			return
		}
	}

	document.addEventListener('astro:page-load', setup)
</script>
