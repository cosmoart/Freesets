---
import type { Asset } from '@/types'

interface Props {
	asset: Asset
	color: string
}

const { asset, color } = Astro.props
const license = asset.license ?? asset.licence
const licenseLink = asset.licenseLink ?? asset.licenceLink
---

<article
	class="group relative flex h-full w-full flex-col overflow-hidden p-3 outline outline-white/5 transition-all hover:bg-white/5"
	style={`--card-color: ${color}`}
>
	<a
		href={asset.link}
		target="_blank"
		rel="noopener noreferrer nofollow"
		aria-label={`Open ${asset.name}`}
		class="absolute inset-0 z-10"></a>

	<div class="relative">
		<img
			src={asset.img}
			alt={`${asset.name} web preview`}
			width="384"
			height="216"
			loading="lazy"
			class="inline-block aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-103"
		/>

		{
			asset.tags && (
				<ul class="absolute top-2 right-2 flex flex-wrap justify-end gap-1">
					{asset.tags.map((tag) => (
						<li class="rounded-md bg-zinc-900/80 px-2 py-0.5 text-xs text-white">{tag}</li>
					))}
				</ul>
			)
		}
	</div>

	<div class="mt-auto flex flex-wrap items-center justify-between gap-2 p-3">
		<div class="flex items-center gap-2">
			<img
				src={`https://www.google.com/s2/favicons?domain=${asset.link}&sz=128`}
				alt=""
				width="44"
				height="44"
				loading="lazy"
				class="aspect-square w-7 shrink-0 rounded-md object-cover"
			/>
			<h3 class="font-medium group-hover:underline">{asset.name}</h3>
		</div>

		{
			license &&
				(licenseLink ? (
					<a
						href={licenseLink}
						target="_blank"
						rel="noopener noreferrer nofollow"
						title={asset.licenseDescription}
						class="relative z-20 inline-block rounded-md bg-blue-700 px-2 py-1 text-[13px] tracking-wide text-white transition-transform hover:scale-105"
					>
						{license}
					</a>
				) : (
					<span
						title={asset.licenseDescription}
						class="inline-block rounded-md bg-blue-700 px-2 py-1 text-[13px] tracking-wide text-white"
					>
						{license}
					</span>
				))
		}
	</div>
</article>
