---
import HeaderSearch from '@/components/HeaderSearch.astro'
import ThemeToggle from '@/components/ThemeToggle.astro'
import GitHubStars from '@/components/GitHubStars.astro'
import SuggestDialog from '@/components/SuggestDialog.astro'
import CategoriesSlider from '@/components/CategoriesSlider.astro'
import Logo from '@/components/Logo.astro'
---

<nav
	aria-label="Main"
	transition:name="header"
	class="relative z-50 flex flex-wrap items-center gap-x-2 gap-y-3">
	<a
		href="/"
		class="flex h-11 shrink-0 items-center gap-2.5 text-[22px] font-bold tracking-tight">
		<Logo class="size-10 shrink-0" />
		Freesets
	</a>
	<div class="relative order-last flex w-full items-center gap-2 md:order-0 md:ml-auto md:w-auto">
		<HeaderSearch />
		<GitHubStars />
	</div>
	<div class="ml-auto flex items-center gap-2 md:ml-0">
		<SuggestDialog />
		<ThemeToggle />
	</div>
</nav>

<CategoriesSlider />
