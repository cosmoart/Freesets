---
import categories from '@/assets/categories'
import HeaderSearch from '@/components/HeaderSearch.astro'
import ThemeToggle from '@/components/ThemeToggle.astro'
import GitHubStars from '@/components/GitHubStars.astro'
import SuggestDialog from '@/components/SuggestDialog.astro'

const current = Astro.url.pathname.split('/')[1]
---

<nav transition:name="header" class="relative z-50 mb-10 flex flex-col gap-3">
	<div class="flex flex-wrap items-center gap-3">
		<a
			href="/"
			class="flex h-11 shrink-0 items-center text-2xl font-semibold transition-opacity hover:opacity-70"
		>
			Freesets
		</a>
		<div class="ml-auto flex flex-wrap items-center gap-3">
			<HeaderSearch />
			<ThemeToggle />
			<SuggestDialog />
			<GitHubStars />
		</div>
	</div>

	<ul class="flex flex-wrap gap-2">
		{
			categories.map((category) => (
				<li>
					<a
						href={`/${category.nameID}`}
						style={`--item-color: ${category.color}`}
						class:list={[
							'flex items-center gap-2.5 rounded-full bg-zinc-100 outline-2 -outline-offset-2 transition-colors dark:bg-zinc-900',
							category.nameID === current
								? 'outline-(--item-color)'
								: 'outline-zinc-200 hover:outline-zinc-400 dark:outline-zinc-800 dark:hover:outline-zinc-600'
						]}
					>
						<span class="flex size-8 items-center justify-center rounded-full bg-(--item-color)">
							<img
								src={`/categories-icons/${category.nameID}.svg`}
								alt=""
								width="18"
								height="18"
								class="w-4.5 invert"
							/>
						</span>
						<span class="py-1 pe-3 text-sm font-medium">{category.name}</span>
					</a>
				</li>
			))
		}
	</ul>
</nav>
