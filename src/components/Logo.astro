---
interface Props {
	class?: string
}

const { class: className } = Astro.props
---

<svg viewBox="0 0 64 64" fill="none" aria-hidden="true" class:list={['logo', className]}>
	<path
		class="logo-shape logo-circle"
		fill="#2cc9a0"
		d="M17.5 33a8.5 8.5 0 1 0 0-17 8.5 8.5 0 0 0 0 17"></path>
	<path
		class="logo-shape logo-square"
		fill="#4f6bf5"
		d="m41.151 12.193-5.61-6.81a3.09 3.09 0 0 0-4.348-.42l-6.81 5.612a3.09 3.09 0 0 0-.42 4.348l5.612 6.81a3.09 3.09 0 0 0 4.347.419l6.81-5.612a3.09 3.09 0 0 0 .42-4.347"
	></path>
	<path
		class="logo-shape logo-triangle"
		fill="#f5a623"
		stroke="#f5a623"
		stroke-linejoin="round"
		stroke-width="3"
		d="m46.921 16.345 7.703 15.014L38 30.668z"></path>
	<path fill="#5b4ff5" d="M32.3 40v22l-20.4-6.4Q10.002 55 9.8 53L8.2 36q-.2-2 1.7-1.5z"></path>
	<path fill="#4538dc" d="M32 40v22l20.1-6.4Q54 55 54.2 53l1.6-17q.2-2-1.7-1.5z"></path>
	<path
		fill="#7a70ff"
		d="m32 40-4.8 6.4q-1.2 1.6-3.1 1L3.9 41.6Q2 41 3.3 39.5l3.4-4q1.3-1.5 3.2-1z"></path>
	<path
		fill="#6358f7"
		d="m32 40 4.8 6.4q1.2 1.6 3.1 1l20.2-5.8q1.9-.6.6-2.1l-3.4-4q-1.3-1.5-3.2-1z"></path>
</svg>

<style>
	.logo-shape {
		transition: translate 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	:global(a:hover) .logo-circle {
		translate: -3px -3px;
	}

	:global(a:hover) .logo-square {
		translate: 0 -4px;
	}

	:global(a:hover) .logo-triangle {
		translate: 3px -3px;
	}

	@media (prefers-reduced-motion: reduce) {
		.logo-shape {
			transition: none;
		}
	}
</style>
