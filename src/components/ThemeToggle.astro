---
const icons = {
	light: [
		'M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0',
		'M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7'
	],
	dark: ['M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z'],
	system: [
		'M3 5a1 1 0 0 1 1 -1h16a1 1 0 0 1 1 1v10a1 1 0 0 1 -1 1h-16a1 1 0 0 1 -1 -1v-10z',
		'M7 20h10',
		'M9 16v4',
		'M15 16v4'
	]
}

const modes = [
	{ value: 'light', label: 'Light', paths: icons.light },
	{ value: 'dark', label: 'Dark', paths: icons.dark },
	{ value: 'system', label: 'Device theme', paths: icons.system }
]

const svg = {
	viewBox: '0 0 24 24',
	fill: 'none',
	stroke: 'currentColor',
	'stroke-width': '2',
	'stroke-linecap': 'round',
	'stroke-linejoin': 'round',
	'aria-hidden': 'true'
} as const

// Both glyphs share one grid cell and trade places by spinning and scaling through each other.
const swap =
	'size-4 [grid-area:1/1] transition-[rotate,scale,opacity] duration-250 ease-[cubic-bezier(0.2,0,0,1)] motion-reduce:transition-none'
---

<div data-theme class="relative">
	<button
		type="button"
		data-theme-toggle
		aria-label="Toggle color theme"
		title="Toggle color theme (right-click for more options)"
		class="btn w-9 btn-ghost px-0"
	>
		<span class="grid place-items-center">
			<svg {...svg} class={`${swap} dark:scale-0 dark:rotate-90 dark:opacity-0`}>
				{icons.dark.map((d) => <path d={d} />)}
			</svg>
			<svg
				{...svg}
				class={`${swap} scale-0 -rotate-90 opacity-0 dark:scale-100 dark:rotate-0 dark:opacity-100`}
			>
				{icons.light.map((d) => <path d={d} />)}
			</svg>
		</span>
	</button>

	<div
		data-theme-menu
		role="menu"
		aria-label="Color theme"
		class="invisible absolute top-full right-0 z-50 mt-2 w-44 origin-top-right scale-95 rounded-xl border border-line bg-card p-1 opacity-0 shadow-[0_16px_40px_rgb(0_0_0/0.3)] transition-[opacity,scale,visibility] duration-150 data-open:visible data-open:scale-100 data-open:opacity-100 data-open:transition-[opacity,scale] motion-reduce:transition-none"
	>
		{
			modes.map((mode) => (
				<button
					type="button"
					role="menuitemradio"
					aria-checked="false"
					data-theme-option={mode.value}
					class="group flex w-full cursor-pointer items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-sm text-soft outline-none hover:bg-hover hover:text-ink focus-visible:bg-hover focus-visible:text-ink aria-checked:text-ink"
				>
					<svg {...svg} class="size-4 shrink-0">
						{mode.paths.map((d) => (
							<path d={d} />
						))}
					</svg>
					<span class="grow text-left">{mode.label}</span>
					<svg {...svg} class="size-3.5 shrink-0 opacity-0 group-aria-checked:opacity-100">
						<path d="M5 12l5 5l10 -10" />
					</svg>
				</button>
			))
		}
	</div>
</div>

<script>
	type Mode = 'light' | 'dark' | 'system'

	const STORAGE_KEY = 'theme'
	const systemDark = matchMedia('(prefers-color-scheme: dark)')

	/** Device theme is stored as the absence of a choice, which is what Layout's inline script reads. */
	function readMode(): Mode {
		const stored = localStorage.getItem(STORAGE_KEY)
		return stored === 'light' || stored === 'dark' ? stored : 'system'
	}

	function saveMode(mode: Mode) {
		if (mode === 'system') localStorage.removeItem(STORAGE_KEY)
		else localStorage.setItem(STORAGE_KEY, mode)
	}

	async function reveal(button: HTMLElement, apply: () => void) {
		const root = document.documentElement
		const { left, top, width, height } = button.getBoundingClientRect()
		const x = left + width / 2
		const y = top + height / 2
		const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y))

		root.dataset.themeTransition = ''

		try {
			const transition = document.startViewTransition(apply)
			await transition.ready

			root.animate(
				{
					clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`]
				},
				{
					duration: 500,
					easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
					pseudoElement: '::view-transition-new(root)'
				}
			)

			await transition.finished
		} finally {
			delete root.dataset.themeTransition
		}
	}

	function setDark(button: HTMLElement, dark: boolean) {
		const root = document.documentElement
		if (root.classList.contains('dark') === dark) return

		const apply = () => root.classList.toggle('dark', dark)
		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches

		if (reduced || !document.startViewTransition) {
			apply()
			return
		}

		reveal(button, apply)
	}

	function setup() {
		const root = document.querySelector<HTMLElement>('[data-theme]')
		const button = root?.querySelector<HTMLButtonElement>('[data-theme-toggle]')
		const menu = root?.querySelector<HTMLElement>('[data-theme-menu]')
		if (!root || !button || !menu) return

		const options = [...menu.querySelectorAll<HTMLButtonElement>('[data-theme-option]')]

		// The menu can stay open while the theme changes (toggle click, another tab), so every
		// change of the stored mode re-marks the checked option, not just opening the menu.
		const syncChecked = () => {
			const mode = readMode()
			for (const option of options) {
				option.setAttribute('aria-checked', String(option.dataset.themeOption === mode))
			}
		}

		const open = () => {
			syncChecked()
			menu.toggleAttribute('data-open', true)
			const checked = options.find((option) => option.getAttribute('aria-checked') === 'true')
			;(checked ?? options[0])!.focus()
		}

		const close = (refocus = false) => {
			if (!menu.hasAttribute('data-open')) return
			menu.removeAttribute('data-open')
			if (refocus) button.focus()
		}

		button.addEventListener('click', () => {
			const dark = !document.documentElement.classList.contains('dark')
			saveMode(dark ? 'dark' : 'light')
			syncChecked()
			setDark(button, dark)
		})

		// Also fires for the keyboard's context menu key and Shift+F10.
		button.addEventListener('contextmenu', (event) => {
			event.preventDefault()
			open()
		})

		for (const option of options) {
			option.addEventListener('click', () => {
				const mode = option.dataset.themeOption as Mode
				saveMode(mode)
				syncChecked()
				close(true)
				setDark(button, mode === 'system' ? systemDark.matches : mode === 'dark')
			})
		}

		menu.addEventListener('keydown', (event) => {
			const index = options.indexOf(document.activeElement as HTMLButtonElement)

			if (event.key === 'Escape') {
				event.preventDefault()
				close(true)
			} else if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
				event.preventDefault()
				const step = event.key === 'ArrowDown' ? 1 : -1
				options[(index + step + options.length) % options.length]!.focus()
			} else if (event.key === 'Tab') {
				close()
			}
		})

		const controller = new AbortController()
		document.addEventListener(
			'pointerdown',
			(event) => {
				if (!root.contains(event.target as Node)) close()
			},
			{ signal: controller.signal }
		)
		window.addEventListener(
			'storage',
			(event) => {
				if (event.key === STORAGE_KEY || event.key === null) syncChecked()
			},
			{ signal: controller.signal }
		)
		document.addEventListener('astro:before-swap', () => controller.abort(), { once: true })
	}

	document.addEventListener('astro:page-load', setup)
</script>
