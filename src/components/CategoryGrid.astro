---
import categories from '@/assets/categories'
---

<section id="categories" class="flex scroll-mt-20 flex-col gap-5">
	<h2 class="text-2xl font-semibold">Browse by category</h2>

	<ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
		{
			categories.map((category) => (
				<li>
					<a
						href={`/${category.nameID}`}
						style={`--item-color: ${category.color}`}
						class="flex h-full items-start gap-4 rounded-xl border border-zinc-200 p-4 outline-2 -outline-offset-2 outline-transparent transition-colors hover:outline-(--item-color) dark:border-zinc-800"
					>
						<span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-(--item-color)">
							<img
								src={`/categories-icons/${category.nameID}.svg`}
								alt=""
								width="22"
								height="22"
								loading="lazy"
								class="w-5.5 invert"
							/>
						</span>

						<span class="flex flex-col gap-1">
							<span class="flex flex-wrap items-center gap-2">
								<span class="font-medium">{category.name}</span>
								<span class="text-xs text-zinc-500">{category.assets.length}</span>
							</span>
							<span class="text-sm text-zinc-500">{category.description}</span>
						</span>
					</a>
				</li>
			))
		}
	</ul>
</section>
