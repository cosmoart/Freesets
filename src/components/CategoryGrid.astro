---
import categories from '@/assets/categories'
---

<section id="categories" class="flex scroll-mt-20 flex-col gap-4">
	<h2 class="text-xl font-semibold">Browse by category</h2>

	<ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
		{
			categories.map((category) => (
				<li>
					<a
						href={`/${category.nameID}`}
						style={`--item-color: ${category.color}`}
						class="flex h-full items-start gap-3.5 rounded-xl surface p-4 transition-colors hover:border-(--item-color)"
					>
						<span class="flex size-10 shrink-0 items-center justify-center rounded-[10px] bg-(--item-color) shadow-[0_0_18px_color-mix(in_srgb,var(--item-color)_35%,transparent)]">
							<img
								src={`/categories-icons/${category.nameID}.svg`}
								alt=""
								width="20"
								height="20"
								loading="lazy"
								class="w-5 invert"
							/>
						</span>

						<span class="flex min-w-0 flex-1 flex-col gap-1">
							<span class="flex items-baseline justify-between gap-2">
								<span class="font-medium">{category.name}</span>
								<span class="font-mono text-[11px] text-subtle tabular-nums">
									{category.assets.length}
								</span>
							</span>
							<span class="text-[13.5px] leading-snug text-muted">{category.description}</span>
						</span>
					</a>
				</li>
			))
		}
	</ul>
</section>
