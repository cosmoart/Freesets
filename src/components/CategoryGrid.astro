---
import categories from '@/assets/categories'
---

<section id="categories" class="flex scroll-mt-20 flex-col gap-5">
	<header class="flex flex-wrap items-baseline gap-3 border-b border-line pb-4">
		<h2 class="text-xl font-semibold">Browse by category</h2>
		<span class="eyebrow">{categories.length} categories</span>
	</header>

	<ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
		{
			categories.map((category) => (
				<li>
					<a
						href={`/${category.nameID}`}
						style={`--item-color: ${category.color}`}
						class="group relative flex h-full flex-col gap-4 overflow-hidden rounded-xl surface p-4.5 transition-[border-color,translate] duration-200 hover:-translate-y-0.5 hover:border-[color-mix(in_srgb,var(--item-color)_45%,var(--line))] motion-reduce:transition-none motion-reduce:hover:translate-y-0"
					>
						<!-- Colored top edge, fading out at both ends -->
						<span
							aria-hidden="true"
							class="pointer-events-none absolute inset-x-0 top-0 h-0.5 bg-linear-to-r from-transparent via-(--item-color) to-transparent opacity-90"
						/>
						<!-- Glow cast by the icon into the top-left corner -->
						<span
							aria-hidden="true"
							class="pointer-events-none absolute inset-0 bg-[radial-gradient(60%_80%_at_0%_0%,color-mix(in_srgb,var(--item-color)_16%,transparent),transparent_70%)] opacity-80 transition-opacity duration-200 group-hover:opacity-100"
						/>

						<span class="relative flex items-center gap-3">
							<span class="flex size-10 shrink-0 items-center justify-center rounded-[10px] bg-(--item-color) shadow-[0_0_24px_color-mix(in_srgb,var(--item-color)_45%,transparent)]">
								<img
									src={`/categories-icons/${category.nameID}.svg`}
									alt=""
									width="20"
									height="20"
									loading="lazy"
									class="w-5 invert"
								/>
							</span>

							<span class="min-w-0 grow truncate font-semibold text-lg">{category.name}</span>

							<span class="flex shrink-0 flex-col items-end">
								<span class="text-2xl leading-none font-bold tracking-tight tabular-nums">
									{category.assets.length}
								</span>
								<span class="mt-1 font-mono text-[10px] tracking-[0.14em] text-subtle uppercase">
									items
								</span>
							</span>
						</span>

						<span class="relative text-[13.5px] leading-relaxed text-pretty text-muted">
							{category.description}
						</span>
					</a>
				</li>
			))
		}
	</ul>
</section>
