---
import { ClientRouter } from 'astro:transitions'
import '@/styles/global.css'
import NavBar from '@/components/NavBar.astro'
import Footer from '@/components/Footer.astro'

interface Props {
	title: string
	description: string
	image: string
	themeColor?: string
}

const { title, description, image, themeColor } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Cosmo" />
		<meta name="robots" content="index, follow" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonical} />
		{themeColor && <meta name="theme-color" content={themeColor} />}

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Gabarito:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
		/>

		<meta property="og:title" content={title} />
		<meta property="og:site_name" content="Freesets" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={image} />
		<meta property="og:description" content={description} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:creator" content="@CosmoArt0" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />

		<ClientRouter />

		<script is:inline>
			;(() => {
				const apply = () => {
					const stored = localStorage.getItem('theme')
					const dark = stored
						? stored === 'dark'
						: matchMedia('(prefers-color-scheme: dark)').matches
					document.documentElement.classList.toggle('dark', dark)
				}

				apply()

				if (!window.themeListenerReady) {
					window.themeListenerReady = true
					document.addEventListener('astro:after-swap', apply)
					// With no stored choice the page follows the device, so track it changing live.
					matchMedia('(prefers-color-scheme: dark)').addEventListener('change', apply)
				}
			})()
		</script>
	</head>
	<body class="bg-canvas text-ink">
		<div
			data-page-surface
			class="relative z-10 mb-(--footer-height) border-b border-line bg-canvas bg-grid shadow-[0_1rem_2rem_rgba(0,0,0,0.25)]"
		>
			{
				themeColor && (
					<div
						aria-hidden="true"
						transition:name="accent-blobs"
						class="accent-blobs"
						style={`--accent: ${themeColor}`}
					>
						<span />
						<span />
					</div>
				)
			}

			<div class="relative mx-auto flex min-h-dvh max-w-380 flex-col p-4">
				<NavBar />
				<main transition:name="page" class="flex grow flex-col">
					<slot />
				</main>
			</div>
		</div>

		<Footer />

		<script>
			import type { TransitionBeforeSwapEvent } from 'astro:transitions/client'

			// Navigation scrolls the new page to the top, which would drag the outgoing snapshots up to
			// where the incoming page sits. Shifting them by that distance keeps them in place while
			// they fade (see --vt-scroll-shift in global.css).
			document.addEventListener('astro:before-swap', (event) => {
				const { viewTransition } = event as TransitionBeforeSwapEvent
				const root = document.documentElement
				const before = document.querySelector('main')?.getBoundingClientRect().top ?? 0

				viewTransition.ready
					.then(() => {
						const after = document.querySelector('main')?.getBoundingClientRect().top ?? 0
						root.style.setProperty('--vt-scroll-shift', `${before - after}px`)
					})
					.catch(() => {})

				viewTransition.finished.finally(() => root.style.removeProperty('--vt-scroll-shift'))
			})
		</script>
	</body>
</html>
